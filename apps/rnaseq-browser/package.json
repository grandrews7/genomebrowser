{
  "name": "@weng-lab/rnaseq-browser",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc6 --noEmit",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt . --check",
    "build:bucket": "vite build --base=/living-models-browser-data/app/",
    "deploy:bucket": "pnpm run build:bucket && gcloud storage cp -r dist/* gs://living-models-browser-data/app/ && gcloud storage objects update gs://living-models-browser-data/app/index.html --cache-control=\"no-cache, max-age=0\""
  },
  "dependencies": {
    "@emotion/react": "catalog:",
    "@emotion/styled": "catalog:",
    "@mui/material": "catalog:",
    "@weng-lab/genomebrowser": "workspace:*",
    "@weng-lab/genomebrowser-tracks": "workspace:*",
    "@weng-lab/genomic-reader": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "^5.0.0",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite": "^7.0.0"
  }
}
